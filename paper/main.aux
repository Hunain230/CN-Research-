\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Per-queue metric deltas as a grouped bar chart. Each bar cluster shows the endpoint-fallback minus frozen-baseline difference for Recall@20 (navy), recoverability (teal), and P@10 (amber) in the same queue. Bars below the zero line indicate queues where the fallback underperformed the baseline. Column totals: +10 recalled, +18 recoverable, +6 P@10 credits.}}{8}{figure.caption.23}\protected@file@percent }
\newlabel{fig:queuebars}{{18}{8}{Per-queue metric deltas as a grouped bar chart. Each bar cluster shows the endpoint-fallback minus frozen-baseline difference for Recall@20 (navy), recoverability (teal), and P@10 (amber) in the same queue. Bars below the zero line indicate queues where the fallback underperformed the baseline. Column totals: +10 recalled, +18 recoverable, +6 P@10 credits}{figure.caption.23}{}}
