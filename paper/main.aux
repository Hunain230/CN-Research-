\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Initial fragments and accepted evidence-token unions form the final partition. Scoring orders these fixed groups. The evaluator separately checks whether an expert incident has a sufficiently complete and pure group anywhere (recoverability) and whether one appears within the first 20 (Recall@20); ranking cannot create a missing group.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:groups}{{7}{5}{Initial fragments and accepted evidence-token unions form the final partition. Scoring orders these fixed groups. The evaluator separately checks whether an expert incident has a sufficiently complete and pure group anywhere (recoverability) and whether one appears within the first 20 (Recall@20); ranking cannot create a missing group}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Experimental protocol overview: controlled training, development with the missed gate condition, documented authorization, and frozen holdout evaluation. Source/prediction hashes were SHA-256 sealed before private-truth access. No post-result holdout tuning occurred.}}{5}{figure.caption.11}\protected@file@percent }
\newlabel{fig:expoverview}{{8}{5}{Experimental protocol overview: controlled training, development with the missed gate condition, documented authorization, and frozen holdout evaluation. Source/prediction hashes were SHA-256 sealed before private-truth access. No post-result holdout tuning occurred}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Experimental order: training and development, the missed 170/200 development gate, the documented authorization to test the unchanged candidate, a fresh synthetic holdout, SHA-256 sealing, and one subsequent private-truth evaluation. No post-result holdout tuning is represented.}}{5}{figure.caption.12}\protected@file@percent }
\newlabel{fig:protocol}{{9}{5}{Experimental order: training and development, the missed 170/200 development gate, the documented authorization to test the unchanged candidate, a fresh synthetic holdout, SHA-256 sealing, and one subsequent private-truth evaluation. No post-result holdout tuning is represented}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Annotated development trajectory from training through holdout. The gate miss and authorization decision are shown explicitly; both occurred before the holdout population was created or any truth label was accessed.}}{5}{figure.caption.13}\protected@file@percent }
\newlabel{fig:devtraj}{{10}{5}{Annotated development trajectory from training through holdout. The gate miss and authorization decision are shown explicitly; both occurred before the holdout population was created or any truth label was accessed}{figure.caption.13}{}}
