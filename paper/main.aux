\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Schematic point-in-time evidence record with illustrative minute values, not measured holdout observations. The original endpoint, identity, and network observations carry distinct roots E, I, and N. The derived identity copy retains root I, a contradictory observation cannot support the relationship, and an observation made at event minute 60 but available only at minute 105 is invisible at the minute-100 decision. Event time and evidence availability are different fields.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:provenance}{{3}{3}{Schematic point-in-time evidence record with illustrative minute values, not measured holdout observations. The original endpoint, identity, and network observations carry distinct roots E, I, and N. The derived identity copy retains root I, a contradictory observation cannot support the relationship, and an observation made at event minute 60 but available only at minute 105 is invisible at the minute-100 decision. Event time and evidence availability are different fields}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Detailed evidence-token bundle processing within the verifier. Each claim bundle is checked for provenance roots, temporal availability, and claim consistency. Only bundles that pass all three checks—and satisfy component-context guards—may add a cross-fragment union.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:corrarch}{{4}{3}{Detailed evidence-token bundle processing within the verifier. Each claim bundle is checked for provenance roots, temporal availability, and claim consistency. Only bundles that pass all three checks—and satisfy component-context guards—may add a cross-fragment union}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Data-flow summary of the frozen C/V/P pipeline. The fallback branch is reachable only from the verifier for \texttt  {missing\_family} rejections; all other failure modes retain the prior partition. Alert and queue counts are from the primary synthetic holdout (5,018 eligible alerts, 15 queues, cutoff $T=100$).}}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pipeline}{{5}{3}{Data-flow summary of the frozen C/V/P pipeline. The fallback branch is reachable only from the verifier for \texttt {missing\_family} rejections; all other failure modes retain the prior partition. Alert and queue counts are from the primary synthetic holdout (5,018 eligible alerts, 15 queues, cutoff $T=100$)}{figure.caption.7}{}}
