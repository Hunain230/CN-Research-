\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Safety audit across all 15 holdout queues. Every queue in both arms records zero false grouped pairs and zero mixed groups under simulator truth. Grouped-pair precision reaches 100\% in both the frozen baseline and the endpoint fallback candidate.}}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:safetyaudit}{{14}{7}{Safety audit across all 15 holdout queues. Every queue in both arms records zero false grouped pairs and zero mixed groups under simulator truth. Grouped-pair precision reaches 100\% in both the frozen baseline and the endpoint fallback candidate}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Grouped-pair and mixed-group outcomes on the 15-queue controlled holdout. Pair precision uses all within-group pairs; the count of safe queues is based on zero false grouped pairs and zero mixed groups in each queue. Zero observed errors under simulator truth is not a bound on real-world error rates.}}{7}{figure.caption.20}\protected@file@percent }
\newlabel{fig:safety}{{15}{7}{Grouped-pair and mixed-group outcomes on the 15-queue controlled holdout. Pair precision uses all within-group pairs; the count of safe queues is based on zero false grouped pairs and zero mixed groups in each queue. Zero observed errors under simulator truth is not a bound on real-world error rates}{figure.caption.20}{}}
